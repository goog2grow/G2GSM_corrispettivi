# Copiare questo file in ".env" e compilare con le credenziali reali.
# NON committare mai il file ".env" (contiene credenziali).
#
# Questo progetto usa un database MySQL dedicato e separato da qualsiasi
# altro progetto/applicazione. Non inserire qui credenziali di altri DB.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nome_database_dedicato
DB_USER=nome_utente_dedicato
DB_PASS=password_utente_dedicato

# true in sviluppo per vedere gli errori PHP a video, false in produzione
APP_DEBUG=false

APP_TIMEZONE=Europe/Rome
